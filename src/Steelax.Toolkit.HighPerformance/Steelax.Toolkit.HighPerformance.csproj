<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Toolkit.HighPerformance</PackageId>
        <Description>High-performance primitives (lock-free queues, event tasks, fan-in signaling) used by Steelax.Pufflow dataflow pipelines.</Description>
        <PackageTags>high-performance;concurrency;lock-free;primitives;dataflow;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Steelax.Toolkit.HighPerformance.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="repomix-output.md" />
    </ItemGroup>

</Project>
